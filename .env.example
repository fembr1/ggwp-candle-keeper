# Copy this file to .env and fill in the values.
# cp .env.example .env

# --- Dashboard (npm start) ---
# Required on Railway. If unset locally, a one-time password is printed at boot.
ADMIN_PASSWORD=change-me
# Optional. Random secret is generated per process if unset (sessions reset on restart).
SESSION_SECRET=
# PORT is set automatically by Railway.
# PORT=3000

# --- Client (required to start hitting) ---
# tiket.com bearer JWT(s) from your session(s). Expires periodically — refresh on 401/403.
# Single user: one JWT. Multi-user: comma-separated JWTs; hits round-robin across them.
# ACCESS_TOKEN=token_a,token_b,token_c
ACCESS_TOKEN=your_tiket_access_token_here
# Round/session id from .../session/{id}/hit.
CAMPAIGN_SESSION_ID=your_session_id_here

# --- Optional (defaults shown) ---
SOCKET_URL=wss://api.tiket.com/ms-gateway/tix-ggwp-ws-hub/v1/ws/
API_BASE_URL=https://www.tiket.com/ms-gateway/ggwp-server/harta-karun/session
# Fire the POST when the countdown is within this many milliseconds.
MAX_MS_DIFF=1300
# Optional wall-clock hard stop (ISO datetime). Empty = keep bidding until Stop.
# Example: STOP_AT=2026-08-12T18:00:00+07:00
STOP_AT=
